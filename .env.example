# ===========================================================================
# Vera Bot - Environment Configuration Template
# ===========================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Option 1: Groq API Key (Fast LPU inference, Free Tier available at https://console.groq.com/keys)
# Starts with: gsk_...
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Option 2: Google Gemini API Key (Free tier at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Option 3: xAI Grok API Key (https://console.x.ai)
GROK_API_KEY=your_xai_api_key_here
GROK_MODEL=grok-3-mini

# Optional: Server Port (Default: 8080)
PORT=8080
